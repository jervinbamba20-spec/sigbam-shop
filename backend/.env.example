# Server
HOST=0.0.0.0
PORT=1337

# Secrets: generate your own random values, never commit real ones
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (PostgreSQL)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=ecommerce
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
# In the cloud you can use a single connection string instead:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: comma-separated list of frontend URLs allowed to call the API
# CORS_ORIGINS=https://your-shop.vercel.app,http://localhost:3001

# Optional: store uploaded images on Cloudinary (required on Render free tier)
# CLOUDINARY_NAME=
# CLOUDINARY_KEY=
# CLOUDINARY_SECRET=

# Set to false to skip inserting the sample products on first start
# SEED_DATA=true
